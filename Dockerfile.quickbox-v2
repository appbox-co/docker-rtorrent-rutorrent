# ruTorrent 5.3.15.10: the published 5.3.15.9 image plus club-QuickBox v2.7.2
# as the theme club-QuickBox-v2, next to the original club-QuickBox (v5.0),
# which stays as it is.
#
# rootfs/var/www/rutorrent/plugins/theme/themes/club-QuickBox-v2 is upstream
# QuickBox/club-QuickBox at e24bfbd (v2.7.2) without bin/, docs/ and .github/,
# with two Appbox edits: init.js recognises its own stylesheets under the
# club-QuickBox-v2 directory, and js/about.js has no GitHub update check.
# scripts/patch-autodl-rutorrent-html5.py now also generates autodl's
# club-quickbox-v2.min.css (the Filters layout only, as for club-QuickBox).
#
# Starting from the 5.3.15.9 digest keeps rTorrent, libtorrent, ruTorrent,
# the plugins, PHP and every Alpine package exactly as deployed.
# release/verify-quickbox-v2-image.sh is the release gate for this image.
#
# Release build (dedicated builder, from the exact pushed commit):
#   docker build --builder default --pull --no-cache --platform linux/amd64 \
#     -f Dockerfile.quickbox-v2 -t repo.cylo.net/rutorrent:5.3.15.10-0.16.24 .

FROM repo.cylo.net/rutorrent@sha256:b4b93012e2a789d38e1da2a6a446d53f1220d2f676d44853bbce7864f67256df

LABEL io.appbox.rutorrent.base-image="repo.cylo.net/rutorrent@sha256:b4b93012e2a789d38e1da2a6a446d53f1220d2f676d44853bbce7864f67256df"

COPY --chown=nobody:nogroup --chmod=u=rwX,go=rX \
    rootfs/var/www/rutorrent/plugins/theme/themes/club-QuickBox-v2 \
    /var/www/rutorrent/plugins/theme/themes/club-QuickBox-v2

COPY scripts/patch-autodl-rutorrent-html5.py /usr/local/bin/patch-autodl-rutorrent-html5.py

RUN set -eu; \
    plugin=/var/www/rutorrent/plugins/autodl-rutorrent; \
    theme=/var/www/rutorrent/plugins/theme/themes/club-QuickBox-v2; \
    python3 /usr/local/bin/patch-autodl-rutorrent-html5.py "$plugin"; \
    grep -q '^version: 2\.7\.2$' "$theme/plugin.info"; \
    grep -q 'themes/club-QuickBox-v2/' "$theme/init.js"; \
    ! grep -q 'defer(doRemoteCheck)' "$theme/js/about.js"; \
    test -z "$(find "$theme" \( ! -user nobody -o ! -group nogroup \) -print -quit)"; \
    test -z "$(find "$theme" -type f ! -perm 644 -print -quit)"; \
    test -z "$(find "$theme" -type d ! -perm 755 -print -quit)"; \
    for t in club-quickbox club-quickbox-v2 darkbetter materialdesign oblivionblue; do \
        head -n 1 "$plugin/css/$t.min.css" | grep -q '^/\* Generated by Appbox patch-autodl-rutorrent-html5.py'; \
    done; \
    test -f /var/www/rutorrent/plugins/theme/themes/club-QuickBox/style.css; \
    grep -q '^version: 5\.0$' /var/www/rutorrent/plugins/theme/themes/club-QuickBox/plugin.info
