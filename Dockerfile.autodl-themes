# ruTorrent 5.3.15.9: the published 5.3.15.8 image with an updated
# scripts/patch-autodl-rutorrent-html5.py. autodl-rutorrent's own stylesheets
# for Standard, Acid, Blue, Dark, Excel and Oblivion give the Filters window a
# fixed 350px height, so on ruTorrent 5 the filter settings spilled out below
# it and the size fields overlapped OK and Cancel. The script now appends the
# layout 5.3.15.8 introduced for club-QuickBox, DarkBetter, MaterialDesign and
# OblivionBlue to those six stylesheets as well.
#
# 5.3.15.8 is RELEASE-5.3.15.8.md (this file on 5.3.15.7). Starting from its
# immutable digest keeps rTorrent, libtorrent, ruTorrent, the plugins, PHP
# and every Alpine package exactly as deployed. 03-config.sh already runs the
# script on every start, so a persisted custom autodl-rutorrent plugin gets
# the layout as well.
# release/verify-autodl-image.sh is the release gate for this image.
#
# Release build (dedicated builder, from the exact pushed commit):
#   docker build --builder default --pull --no-cache --platform linux/amd64 \
#     -f Dockerfile.autodl-themes -t repo.cylo.net/rutorrent:5.3.15.9-0.16.24 .

FROM repo.cylo.net/rutorrent@sha256:f2d00903ffce4c84bd500d9efc0b968c351695e3ea469be671af170e19c5ec88

LABEL io.appbox.rutorrent.base-image="repo.cylo.net/rutorrent@sha256:f2d00903ffce4c84bd500d9efc0b968c351695e3ea469be671af170e19c5ec88"

COPY scripts/patch-autodl-rutorrent-html5.py /usr/local/bin/patch-autodl-rutorrent-html5.py

RUN set -eu; \
    plugin=/var/www/rutorrent/plugins/autodl-rutorrent; \
    python3 /usr/local/bin/patch-autodl-rutorrent-html5.py "$plugin"; \
    for theme in acid blue dark excel oblivion standard; do \
        test "$(grep -c '^/\* Appbox Filters layout (patch-autodl-rutorrent-html5.py): begin \*/$' "$plugin/css/$theme.min.css")" = 1; \
        test "$(grep -c '^/\* Appbox Filters layout: end \*/$' "$plugin/css/$theme.min.css")" = 1; \
        grep -q '^#autodl-filters-list{height:auto' "$plugin/css/$theme.min.css"; \
        test "$(stat -c '%a %U:%G' "$plugin/css/$theme.min.css")" = "644 nobody:nogroup"; \
    done; \
    for theme in club-quickbox darkbetter materialdesign oblivionblue; do \
        head -n 1 "$plugin/css/$theme.min.css" | grep -q '^/\* Generated by Appbox patch-autodl-rutorrent-html5.py'; \
    done
