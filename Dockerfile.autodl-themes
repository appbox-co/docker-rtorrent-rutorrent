# ruTorrent 5.3.15.8: the published 5.3.15.7 image with an updated
# scripts/patch-autodl-rutorrent-html5.py. autodl-rutorrent loads
# css/<theme>.min.css and ships stylesheets only for Standard, Acid, Blue,
# Dark, Excel and Oblivion, so with club-QuickBox, DarkBetter, MaterialDesign
# or OblivionBlue its Filters window had no layout and grew past the bottom of
# the screen when there were many filters. The script now generates a
# stylesheet for each of those themes that keeps the window on screen.
#
# 5.3.15.7 is RELEASE-5.3.15.7.md (Dockerfile.php-security on 5.3.15.6).
# Starting from its immutable digest keeps rTorrent, libtorrent, ruTorrent,
# the plugins, PHP and every Alpine package exactly as deployed.
# 03-config.sh already runs the script on every start, so a persisted custom
# autodl-rutorrent plugin gets the stylesheets as well.
# release/verify-autodl-image.sh is the release gate for this image.
#
# Release build (dedicated builder, from the exact pushed commit):
#   docker build --builder default --pull --no-cache --platform linux/amd64 \
#     -f Dockerfile.autodl-themes -t repo.cylo.net/rutorrent:5.3.15.8-0.16.24 .

FROM repo.cylo.net/rutorrent@sha256:db1a64429462205a3bc41833e4886fc4205945b5115a907ae6bf303e087b9df6

LABEL io.appbox.rutorrent.base-image="repo.cylo.net/rutorrent@sha256:db1a64429462205a3bc41833e4886fc4205945b5115a907ae6bf303e087b9df6"

COPY scripts/patch-autodl-rutorrent-html5.py /usr/local/bin/patch-autodl-rutorrent-html5.py

RUN set -eu; \
    plugin=/var/www/rutorrent/plugins/autodl-rutorrent; \
    python3 /usr/local/bin/patch-autodl-rutorrent-html5.py "$plugin"; \
    for theme in club-quickbox darkbetter materialdesign oblivionblue; do \
        head -n 1 "$plugin/css/$theme.min.css" | grep -q '^/\* Generated by Appbox patch-autodl-rutorrent-html5.py'; \
        grep -q '^#autodl-filters-list{height:auto' "$plugin/css/$theme.min.css"; \
        chown nobody:nogroup "$plugin/css/$theme.min.css"; \
        chmod 0644 "$plugin/css/$theme.min.css"; \
    done
